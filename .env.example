# ==== Bağban AI — environment (copy to .env, fill real values; .env is NOT committed) ====
# Adapted from spec §26: NO Supabase — self-hosted Postgres + own JWT auth on Hetzner.

# ---- Database (Postgres 16 + PostGIS, self-hosted) ----
DATABASE_URL=postgresql://bagban:change-me@localhost:5432/bagban
POSTGRES_USER=bagban
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bagban

# ---- Auth (own JWT, replaces Supabase Auth) ----
JWT_SECRET=change-me-to-a-long-random-hex   # openssl rand -hex 32
JWT_EXPIRES_HOURS=168
COOKIE_NAME=bagban_session

# ---- Backend / frontend URLs ----
BACKEND_BASE=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_API_TOKEN=change-me   # n8n → backend /api/internal/* auth

# ---- Satellite (NASA HLS via Earthdata) ----
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=            # or use ~/.netrc
STAC_URL=https://cmr.earthdata.nasa.gov/stac/LPCLOUD
GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR
CPL_VSIL_CURL_ALLOWED_EXTENSIONS=.tif

# ---- Weather (Open-Meteo) ----
OPEN_METEO_BASE=https://api.open-meteo.com/v1
OPEN_METEO_API_KEY=            # only for commercial/self-host tier

# ---- AI: TEXT (advice, chat, research, season summary) ----
# Owner's decision 2026-07-30: all text on DeepSeek, model deepseek-v4-flash everywhere
# (v4-pro scored identically on our prompts and runs 4-5x slower).
# LLM_API_KEY serves ONLY the provider named on the line above it — it is never reused for the
# vision provider. See services/app/ai/llm.py::_key_for.
LLM_PROVIDER=deepseek          # anthropic | deepseek   (openai/local are NOT wired)
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
# Alternative to putting the DeepSeek key in LLM_API_KEY (either is read; this one is explicit):
DEEPSEEK_API_KEY=
# DeepSeek reasoning. Leave off: a forced function call with thinking enabled is an HTTP 400, and
# every structured path here uses a forced function call.
DEEPSEEK_THINKING=false

# ---- AI: VISION (photo auto-label, disease diagnosis, soil-lab OCR) ----
# A SEPARATE provider, and not by preference: DeepSeek accepts no images on any endpoint. Its native
# API rejects them outright; its Anthropic-compatible endpoint answers HTTP 200 and quietly replaces
# the picture with the text "[Unsupported Image]" — i.e. pointing vision at DeepSeek deploys green
# and diagnoses nothing. Leave VISION_PROVIDER empty/anthropic and the photo features report
# themselves unavailable rather than guessing.
VISION_PROVIDER=gemini         # gemini | anthropic     (deepseek is refused before any request)
VISION_MODEL=gemini-3.6-flash  # empty = the provider default; gemini-3.1-pro reads poor scans better
GEMINI_API_KEY=

# ---- Storage (local Hetzner volume now; S3-compatible later) ----
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_ROOT=./storage
OBJECT_STORAGE_BUCKET=bagban
TILE_SERVER_BASE=http://localhost:8000/api/tiles

# ---- Notifications (Phase 2) ----
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_TOKEN=
SMS_PROVIDER_KEY=

# ---- Billing: DEFERRED (no payment yet). Kept for future:
# BILLING_PROVIDER=
# BILLING_WEBHOOK_SECRET=
